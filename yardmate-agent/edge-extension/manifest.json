{
  "manifest_version": 3,
  "name": "Mori UP Mismatch Export",
  "version": "0.6.0",
  "description": "Manually or every 15 minutes uses the official UP control to download the mismatch Excel for Mori desktop.",
  "permissions": ["activeTab", "alarms", "scripting", "storage", "tabs"],
  "host_permissions": ["https://employees.www.uprr.com/*", "http://127.0.0.1:43127/*"],
  "action": {
    "default_title": "Mori mismatch export",
    "default_popup": "popup.html",
    "default_icon": "icon.svg"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://employees.www.uprr.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
