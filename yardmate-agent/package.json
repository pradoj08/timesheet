{
  "name": "yardmate-agent",
  "version": "1.1.4",
  "private": true,
  "description": "Local YardMate Excel watcher and phone alert agent.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "check": "node --check main.js && node --check preload.js && node --check renderer.js",
    "dist": "npm run check && electron-builder",
    "dist:win": "npm run check && electron-builder --win",
    "dist:mac": "npm run check && electron-builder --mac"
  },
  "dependencies": {
    "sharp": "^0.35.3",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "electron": "43.1.1",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.yardmate.agent",
    "productName": "YardMate Agent",
    "asar": true,
    "files": [
      "main.js",
      "preload.js",
      "renderer.js",
      "settings.html",
      "assets/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ]
    }
  }
}
